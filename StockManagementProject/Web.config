<?xml version="1.0" encoding="utf-8"?>
<!--
  Runs the site against a local SQL Server LocalDB database (see Database\StockManagement.sql).
  For another server, change the connection string below. For the live site, the connection string is
  entered in Visual Studio's publish settings, so no password is ever stored in this file.
-->
<configuration>
  <connectionStrings>
    <add name="StockManagementDB" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=StockManagement;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- Visitors on other machines see a short error page; the full details only on this machine. -->
    <customErrors mode="RemoteOnly" />
  </system.web>
</configuration>
